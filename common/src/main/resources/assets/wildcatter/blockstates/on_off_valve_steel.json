{
  "multipart": [
    {
      "apply": {
        "model": "wildcatter:block/on_off_valve_steel_core"
      }
    },
    {
      "when": {
        "north": "true|flange"
      },
      "apply": {
        "model": "wildcatter:block/gas_line_arm"
      }
    },
    {
      "when": {
        "north": "flange"
      },
      "apply": {
        "model": "wildcatter:block/gas_line_flange"
      }
    },
    {
      "when": {
        "east": "true|flange"
      },
      "apply": {
        "model": "wildcatter:block/gas_line_arm",
        "y": 90
      }
    },
    {
      "when": {
        "east": "flange"
      },
      "apply": {
        "model": "wildcatter:block/gas_line_flange",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true|flange"
      },
      "apply": {
        "model": "wildcatter:block/gas_line_arm",
        "y": 180
      }
    },
    {
      "when": {
        "south": "flange"
      },
      "apply": {
        "model": "wildcatter:block/gas_line_flange",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true|flange"
      },
      "apply": {
        "model": "wildcatter:block/gas_line_arm",
        "y": 270
      }
    },
    {
      "when": {
        "west": "flange"
      },
      "apply": {
        "model": "wildcatter:block/gas_line_flange",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true|flange"
      },
      "apply": {
        "model": "wildcatter:block/gas_line_arm",
        "x": 270
      }
    },
    {
      "when": {
        "up": "flange"
      },
      "apply": {
        "model": "wildcatter:block/gas_line_flange",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true|flange"
      },
      "apply": {
        "model": "wildcatter:block/gas_line_arm",
        "x": 90
      }
    },
    {
      "when": {
        "down": "flange"
      },
      "apply": {
        "model": "wildcatter:block/gas_line_flange",
        "x": 90
      }
    }
  ]
}
